{
  "id": "plan-projection-closed-set",
  "behavior": "plan-projection-emits-camelcase-closed-set",
  "tests": [
    "the projection validates against the delivered phase-declaration schema, emits exactly the five camelCase keys, and a sixth key is rejected",
    "a files-to-touch entry carrying a parenthetical gloss projects to the bare path, and a directory keeps its trailing slash"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/plan.ts",
      "find": "    filesToTouch: stringArray(phase[\"files-to-touch\"])\n      .map(stripGloss)",
      "replace": "    filesToTouch: stringArray(phase[\"files-to-touch\"])\n      .map((entry) => entry)"
    },
    {
      "kind": "mutation",
      "file": "src/plan.ts",
      "find": "    filename: `${phaseId.toLowerCase()}.json`,",
      "replace": "    filename: `${phaseId}.json`,"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
