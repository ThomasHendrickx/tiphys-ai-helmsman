    {
      "kind": "mutation",
      "file": "src/checks.ts",
      "find": "      const conditions = stringsAt(row.mode, \"conditions\");",
      "replace": "      const conditions: string[] = [];"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
