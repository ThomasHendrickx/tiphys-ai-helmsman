{
  "id": "plan-projection-gloss-stripped",
  "behavior": "plan-projection-strips-files-to-touch-gloss",
  "tests": [
    "a files-to-touch entry carrying a parenthetical gloss projects to the bare path, and a directory keeps its trailing slash"
  ],
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/plan.ts",
      "find": "  const parenthesis = text.indexOf(\"(\");",
      "replace": "  const parenthesis = -1;"
    },
    {
      "kind": "mutation",
      "file": "src/plan.ts",
      "find": "  text = text.replace(/^`+/, \"\").replace(/`+$/, \"\").trim();",
      "replace": "  text = text.trim();"
    }
  ],
  "class": "additive",
  "deterministic": true,
  "repeats": 2
}
