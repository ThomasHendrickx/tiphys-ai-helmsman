{
  "id": "init-prints-next-steps",
  "behavior": "init-prints-next-steps",
  "tests": [
    "init prints the next steps naming the fleet charter location and the project arm"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/commands/init.ts",
      "find": "join(root, CHARTER_DIRECTORY, \"<project>.yaml\")",
      "replace": "join(root, \"<project>.yaml\")"
    },
    {
      "kind": "mutation",
      "file": "src/commands/init.ts",
      "find": "`next: in the project repository run tiphys init ${PROJECT_FLAG} <repo>\\n`",
      "replace": "`next: done\\n`"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
