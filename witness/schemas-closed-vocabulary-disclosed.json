{
  "id": "schemas-closed-vocabulary-disclosed",
  "behavior": "schemas-disclose-closed-vocabulary",
  "tests": [
    "the shipped schemas disclose the closed vocabulary at v0.1.0 and the enums really are closed"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "schemas/assurance-modes.schema.json",
      "find": "\"enum\": [\"full\", \"direct-pr\", \"local-only\"]",
      "replace": "\"enum\": [\"full\", \"direct-pr\", \"local-only\", \"standard\"]"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
