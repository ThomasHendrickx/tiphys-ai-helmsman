{
  "id": "brief-compose-duplicate-phase-id",
  "behavior": "brief-compose-duplicate-phase-id-refused",
  "tests": [
    "brief compose refuses a plan declaring phase M9-P1 twice with the weaker entry first, naming the id"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/ids.ts",
      "find": "    .filter(([, indexes]) => indexes.length > 1)",
      "replace": "    .filter(() => false)"
    },
    {
      "kind": "mutation",
      "file": "src/plan.ts",
      "find": "  return duplicates.length === 0 ? undefined : describeDuplicateIds(source, \"phase\", duplicates);",
      "replace": "  return undefined;"
    },
    {
      "kind": "mutation",
      "file": "src/commands/brief.ts",
      "find": "  if (duplicated !== undefined) {\n    return { ok: false, reason: duplicated };\n  }",
      "replace": "  if (false) {\n    return { ok: false, reason: duplicated };\n  }"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
