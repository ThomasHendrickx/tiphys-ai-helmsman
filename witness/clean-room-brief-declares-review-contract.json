{
  "id": "clean-room-brief-declares-review-contract",
  "behavior": "clean-room-brief-declares-review-contract",
  "tests": [
    "the hazard contract composes, declares itself and opens on its own clause; the dropped criteria contract is refused naming DR-0064, and an unknown contract exits nonzero naming it"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/commands/brief.ts",
      "find": "    if (reviewContract === DROPPED_REVIEW_CONTRACT) {",
      "replace": "    if (reviewContract === \"never-dropped\") {"
    },
    {
      "kind": "mutation",
      "file": "src/roles.ts",
      "find": "export const REVIEW_CONTRACTS: readonly string[] = [\"hazard\"];",
      "replace": "export const REVIEW_CONTRACTS: readonly string[] = [\"criteria\", \"hazard\"];"
    },
    {
      "kind": "mutation",
      "file": "src/commands/brief.ts",
      "find": "    reviewContract = options.reviewContract ?? \"hazard\";",
      "replace": "    reviewContract = options.reviewContract ?? \"criteria\";"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
