{
  "id": "release-manifest-names-the-provenance-repository",
  "behavior": "release-manifest-names-the-provenance-repository",
  "class": "classification",
  "deterministic": true,
  "repeats": 2,
  "tests": [
    "the published manifest names the repository provenance will assert"
  ],
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "package.json",
      "find": "  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/ThomasHendrickx/tiphys-ai-helmsman.git\"\n  },\n",
      "replace": ""
    },
    {
      "kind": "mutation",
      "file": "package.json",
      "find": "\"type\": \"git\",\n    \"url\": \"git+https://github.com/ThomasHendrickx/tiphys-ai-helmsman.git\"",
      "replace": "\"type\": \"git\",\n    \"url\": \"\""
    },
    {
      "kind": "mutation",
      "file": "package.json",
      "find": "ThomasHendrickx/tiphys-ai-helmsman.git",
      "replace": "ThomasHendrickx/some-other-repository.git"
    }
  ]
}
