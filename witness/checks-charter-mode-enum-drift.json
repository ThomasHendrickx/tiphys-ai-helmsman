    {
      "kind": "mutation",
      "file": "src/checks.ts",
      "find": "    for (const field of [\"delivery-mode\", \"assurance-tier\"]) {",
      "replace": "    for (const field of []) {"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
