{
  "id": "cli-top-level-error-handler",
  "behavior": "cli-errors-have-no-stack-trace",
  "tests": [
    "a subcommand that throws prints one diagnostic line, exits nonzero, and puts no stack frame on either stream"
  ],
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "bin/tiphys.ts",
      "find": "  process.stderr.write(`tiphys: ${singleLine(message)}\\n`);",
      "replace": "  throw error;"
    },
    {
      "kind": "mutation",
      "file": "bin/tiphys.ts",
      "find": "  process.exitCode = usage ? EX_USAGE : 1;",
      "replace": "  process.exitCode = 0;"
    },
    {
      "kind": "mutation",
      "file": "src/cli.ts",
      "find": "  [\"validate\", cmdValidate],\n",
      "replace": ""
    }
  ],
  "class": "additive",
  "deterministic": true,
  "repeats": 2
}
