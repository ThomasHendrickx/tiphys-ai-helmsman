{
  "id": "modes-execution-status-derived",
  "behavior": "mode-show-annotates-execution-status",
  "tests": [
    "mode show says which mode is the un-downgraded process and which is a declared downgrade never exercised"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/modes.ts",
      "find": "  if (mode.skips.length === 0) {",
      "replace": "  if (true) {"
    },
    {
      "kind": "mutation",
      "file": "src/modes.ts",
      "find": "  if (!context.shippedDocument) {",
      "replace": "  if (false) {"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
