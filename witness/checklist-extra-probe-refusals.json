{
  "id": "checklist-extra-probe-refusals",
  "behavior": "checklist-extra-probe-collision",
  "tests": [
    "an extra file reusing a canonical probe id is a collision naming both sources",
    "an extra probe that requires no evidence is refused, whether the field is absent or false"
  ],
  "class": "additive",
  "deterministic": true,
  "repeats": 2,
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/checklists.ts",
      "find": "    if (clash !== undefined) {",
      "replace": "    if (clash !== undefined && false) {"
    },
    {
      "kind": "mutation",
      "file": "src/checklists.ts",
      "find": "    if (!probe.evidenceRequired) {",
      "replace": "    if (!probe.evidenceRequired && false) {"
    }
  ]
}
