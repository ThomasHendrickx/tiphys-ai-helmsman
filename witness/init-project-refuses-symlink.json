{
  "id": "init-project-refuses-symlink",
  "behavior": "init-project-refuses-symlink",
  "tests": [
    "init --project refuses a symbolic link at assurance-modes.yaml and leaves it in place"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/commands/init.ts",
      "find": "    existing = lstatSync(target);\n",
      "replace": "    existing = lstatSync(realpathSync(target));\n"
    },
    {
      "kind": "mutation",
      "file": "src/commands/init.ts",
      "find": "  } else if (existing.isSymbolicLink()) {\n",
      "replace": "  } else if (existing.isSymbolicLink() && false) {\n"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
