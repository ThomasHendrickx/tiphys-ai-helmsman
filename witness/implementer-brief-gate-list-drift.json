{
  "id": "implementer-brief-gate-list-drift",
  "behavior": "implementer-brief-gate-list-drift",
  "tests": [
    "the composed brief's gate-list block is byte-identical to the block gate-registry.yaml renders for the declared mode",
    "adding a gate to the project's gate-registry.yaml adds its row to the composed brief, and a registry selecting no gate for the brief's mode refuses to compose"
  ],
  "class": "additive",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/roles.ts",
      "find": "  const selected = registry.gates.filter((gate) => (gate.modes ?? []).includes(mode));",
      "replace": "  const selected = [];"
    },
    {
      "kind": "mutation",
      "file": "src/commands/brief.ts",
      "find": "    body = body.replace(BRIEF_GATE_LIST_PLACEHOLDER, gateList.text);",
      "replace": "    body = body.replace(BRIEF_GATE_LIST_PLACEHOLDER, \"\");"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
