{
  "id": "brief-compose-acceptance-rendered",
  "behavior": "brief-compose-dropped-acceptance-detected",
  "class": "additive",
  "deterministic": true,
  "repeats": 2,
  "tests": [
    "brief compose renders the named phase's acceptance array"
  ],
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/roles.ts",
      "find": "  \"acceptance\",\n",
      "replace": ""
    },
    {
      "kind": "mutation",
      "file": "src/roles.ts",
      "find": "        for (const [key, nested] of entries.slice(1)) {",
      "replace": "        for (const [key, nested] of []) {"
    }
  ]
}
