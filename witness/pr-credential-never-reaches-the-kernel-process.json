{
  "id": "pr-credential-never-reaches-the-kernel-process",
  "behavior": "pr-credential-never-reaches-the-kernel-process",
  "tests": [
    "the pull-request credential never reaches a kernel adapter child, probed from inside the child"
  ],
  "class": "classification",
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "plugin/src/pr.ts",
      "find": "      return { ok: true, name, value };",
      "replace": "      process.env[name] = value;\n      return { ok: true, name, value };"
    },
    {
      "kind": "mutation",
      "file": "plugin/src/pr.ts",
      "find": "  env[credential.name] = credential.value;",
      "replace": "  env[credential.name] = credential.value;\n  Object.assign(process.env, { [credential.name]: credential.value });"
    }
  ],
  "deterministic": true,
  "repeats": 2
}
