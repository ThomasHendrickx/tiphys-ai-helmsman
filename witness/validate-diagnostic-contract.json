{
  "id": "validate-diagnostic-contract",
  "behavior": "validate-invalid-pointer-message",
  "tests": [
    "Ajv errors become the exact Tiphys diagnostic text, and no Ajv-authored wording reaches either stream"
  ],
  "dangerousStates": [
    {
      "kind": "mutation",
      "file": "src/validate.ts",
      "find": "        message: DIAGNOSTIC_MESSAGES.required(String(params[\"missingProperty\"])),",
      "replace": "        message: `must have required property '${String(params[\"missingProperty\"])}'`,"
    },
    {
      "kind": "mutation",
      "file": "src/validate.ts",
      "find": "  return sortDiagnostics([...unique.values()]);",
      "replace": "  return [...unique.values()].reverse();"
    }
  ],
  "class": "additive",
  "deterministic": true,
  "repeats": 2
}
