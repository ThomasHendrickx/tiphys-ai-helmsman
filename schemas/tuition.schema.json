{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/tuition.schema.json",
  "title": "Tiphys tuition entry",
  "description": "One failure mode this project paid for, the mechanism it established and the kernel change it forces; tuition/mechanism-index.yaml is projected from these.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "project",
    "date",
    "stage",
    "kernel-relevant",
    "what-happened",
    "lesson",
    "evidence"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "tuition"
    },
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kernel-relevant": {
      "type": "boolean"
    },
    "what-happened": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "lesson": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanism", "rule", "evidence"],
        "properties": {
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "siblings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "machine-readable-form": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "key"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "structural-consequence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "status", "change"],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "applied", "ticketed"]
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "if": {
    "type": "object",
    "required": ["kernel-relevant"],
    "properties": {
      "kernel-relevant": { "const": true }
    }
  },
  "then": {
    "type": "object",
    "required": ["structural-consequence"],
    "properties": {
      "structural-consequence": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
