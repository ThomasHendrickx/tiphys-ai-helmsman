{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/write-bypass.schema.json",
  "title": "Tiphys write-bypass declaration",
  "description": "<fleet>/write-bypass.json: a named, time-boxed permission for listed working-tree writes in one project clone, with a reason and an expiry instant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "project",
    "paths",
    "reason",
    "expiresAt",
    "declaredBy",
    "declaredAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "write-bypass"
    },
    "contractVersion": {
      "type": "string",
      "enum": ["1"]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
    },
    "declaredBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "declaredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
    }
  }
}
