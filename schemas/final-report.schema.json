{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/final-report.schema.json",
  "title": "Tiphys final report",
  "description": "One document per delivery: each input finding's outcome, whether the intended outcome was delivered, and what remains owed or left behind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "subject",
    "inputs",
    "input-findings",
    "delivered-outcome",
    "not-testable",
    "decisions-owed",
    "owner-verification",
    "infrastructure-left",
    "out-of-band"
  ],
  "properties": {
    "kind": {
      "description": "The artifact type, so `tiphys validate --type auto` resolves this document without being told.",
      "type": "string",
      "const": "final-report"
    },
    "tiphys-version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "subject": {
      "description": "What this report is the final report OF.",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "uniqueItems": true
    },
    "input-findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "outcome": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "delivered-outcome": {
      "description": "Whether the phase delivered the outcome its intent names, and the evidence for that answer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase-intent",
        "delivered",
        "evidence",
        "explanation"
      ],
      "properties": {
        "phase-intent": {
          "description": "The phase intent this report answers, as the plan states it.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "delivered": {
          "description": "Whether that intended outcome was delivered. A boolean, never a degree.",
          "type": "boolean"
        },
        "evidence": {
          "description": "What shows the answer is true: paths with line numbers, commands with exit codes, run URLs.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9]"
          }
        },
        "explanation": {
          "description": "Why the answer is what it is, in plain words, including what was not delivered.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "if": {
        "required": [
          "delivered"
        ],
        "properties": {
          "delivered": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "not-testable": {
      "description": "Per phase, the ids of the criteria the plan marks not-testable, as tiphys plan count prints them; the count is the list's length (DR-0064).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "criteria"],
        "properties": {
          "phase": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "criteria": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      }
    },
    "decisions-owed": { "$ref": "#/$defs/enumerableSection" },
    "owner-verification": { "$ref": "#/$defs/enumerableSection" },
    "infrastructure-left": { "$ref": "#/$defs/enumerableSection" },
    "out-of-band": { "$ref": "#/$defs/enumerableSection" }
  },
  "$defs": {
    "enumerableSection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["none"],
          "properties": { "none": { "type": "boolean", "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "entries"],
          "properties": {
            "none": { "type": "boolean", "const": false },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["statement"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "statement": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "owner": { "type": "string", "minLength": 1, "pattern": "\\S" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
