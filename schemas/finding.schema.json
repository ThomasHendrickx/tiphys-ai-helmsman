{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/finding.schema.json",
  "title": "Tiphys finding set",
  "description": "A finding set: the artifact an adversarial plan review or a clean-room review outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "verdict", "produced-by", "findings"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "finding"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "produced-by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "no-findings-statement": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "oneOf": [
    {
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["no-findings-statement"],
      "properties": {
        "no-findings-statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "evidence", "concrete-edit"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "concrete-edit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
