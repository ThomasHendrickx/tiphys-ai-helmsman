{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/assurance-modes.schema.json",
  "title": "Tiphys assurance modes",
  "description": "One document per repository: which assurance modes exist, the stages each runs and declares it skips, and who may merge under it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "modes"],
  "properties": {
    "kind": {
      "description": "The artifact type, so `tiphys validate --type auto` resolves this document without being told.",
      "type": "string",
      "const": "assurance-modes"
    },
    "note": {
      "description": "Free prose for this document's own readers.",
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "modes": {
      "description": "Every mode this repository declares.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mode"
      }
    }
  },
  "$defs": {
    "stageId": {
      "description": "The closed stage vocabulary at v0.1.0 (DR-0020): the kernel's own stage ids.",
      "type": "string",
      "enum": [
        "intake",
        "verification-pass",
        "plan",
        "adversarial-plan-review",
        "implement",
        "clean-room-review",
        "fix-round",
        "fix-round-verification",
        "merge-on-green",
        "orchestrator-diff-review",
        "deploy-verify",
        "migration-verify",
        "final-report"
      ]
    },
    "mode": {
      "$ref": "#/$defs/modeAuthorityRule",
      "if": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "const": "full"
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["pipeline", "escalation-bounds"],
        "properties": {
          "pipeline": {
            "type": "array",
            "contains": {
              "const": "fix-round-verification"
            }
          },
          "escalation-bounds": {
            "$ref": "#/$defs/escalationBounds"
          }
        }
      }
    },
    "modeAuthorityRule": {
      "$ref": "#/$defs/modeReviewContractRule",
      "if": {
        "type": "object",
        "required": ["merge-authority"],
        "properties": {
          "merge-authority": {
            "const": "delegated-under-conditions"
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["conditions", "granted-by"],
        "properties": {
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "granted-by": {
            "$ref": "#/$defs/decisionRecordReference"
          }
        }
      }
    },
    "modeReviewContractRule": {
      "$ref": "#/$defs/modeShape",
      "if": {
        "type": "object",
        "required": ["pipeline"],
        "properties": {
          "pipeline": {
            "type": "array",
            "contains": {
              "const": "clean-room-review"
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["review-contracts"],
        "properties": {
          "review-contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "modeShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "declared-by",
        "pipeline",
        "skips",
        "merge-authority"
      ],
      "properties": {
        "$comment": {
          "description": "Clause ids this entry discharges, per schemas/README.md.",
          "type": "string"
        },
        "id": {
          "description": "The closed mode vocabulary at v0.1.0 (DR-0020): the three modes of blueprint section 8.",
          "type": "string",
          "enum": ["full", "direct-pr", "local-only"]
        },
        "declared-by": {
          "description": "Where this mode's definition comes from, as prose with document references a reader can check.",
          "type": "string",
          "minLength": 1
        },
        "pipeline": {
          "description": "The stages this mode runs, in order; the order is load-bearing (R-024).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stageId"
          }
        },
        "skips": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stageId"
          }
        },
        "gate-sets": {
          "description": "Ignored since M6-P3: a mode's gates are the gate-registry.yaml gates whose modes name it; accepted so older documents validate.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge-authority": {
          "type": "string",
          "enum": [
            "owner",
            "owner-approves-orchestrator-merges",
            "delegated-under-conditions"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "granted-by": {
          "$ref": "#/$defs/decisionRecordReference"
        },
        "review-contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation-bounds": {
          "$ref": "#/$defs/escalationBounds"
        }
      }
    },
    "decisionRecordReference": {
      "description": "A decision record id, for example DR-0012, which makes a grant checkable against its record.",
      "type": "string",
      "pattern": "^DR-[0-9]{4}$"
    },
    "onExceeded": {
      "type": "string",
      "enum": ["fresh-implementer-and-third-contract", "escalate-to-owner"]
    },
    "escalationBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max-fix-rounds-after-review",
        "recurrence-of-high-in-one-component",
        "on-exceeded"
      ],
      "properties": {
        "max-fix-rounds-after-review": {
          "description": "The ceiling on fix rounds after the first review before the bound fires (DR-0012, DR-0035's table).",
          "type": "integer"
        },
        "recurrence-of-high-in-one-component": {
          "description": "How many times a high-severity finding may recur in one component before the bound fires (DR-0012: one).",
          "type": "integer"
        },
        "on-exceeded": {
          "$ref": "#/$defs/onExceeded"
        }
      }
    }
  }
}
