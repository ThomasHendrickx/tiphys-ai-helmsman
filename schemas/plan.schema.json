{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/plan.schema.json",
  "title": "Tiphys delivery plan",
  "description": "The plan artifact of the orchestrated delivery process (section 1c); every object level refuses a property it does not declare.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "status",
    "baseline-commit",
    "binding-rule",
    "process-summary",
    "standing-context",
    "report-code-disagreement",
    "phases",
    "decisions",
    "open-questions",
    "parked"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "plan"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "superseded"]
    },
    "baseline-commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "binding-rule": {
      "type": "string",
      "const": "If it is not written here, it is not being made. Unanswered questions go to the orchestrator."
    },
    "process-summary": {
      "type": "string",
      "minLength": 1
    },
    "standing-context": {
      "type": "string",
      "minLength": 1
    },
    "report-code-disagreement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "claim", "verified"],
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^M[0-9]+-P[0-9]+$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open-questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DR-[0-9]{4}$"
      }
    },
    "parked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "criterionCheck": {
      "description": "What proves a criterion: exact test titles the suite must report as passing, a command that must exit 0, or both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": {
          "description": "Exact test titles as the suite reports them; each must be reported and pass.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "command": {
          "description": "An argv run with no shell from the project root; exit 0 means proven.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        { "required": ["tests"], "properties": { "tests": { "type": "array" } } },
        {
          "description": "command alone: a present tests array is never null, so this branch excludes it",
          "required": ["command"],
          "properties": { "command": { "type": "array" }, "tests": { "type": "null" } }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "branch",
        "intent",
        "grounding",
        "severity",
        "verified-root-cause",
        "steps",
        "files-to-touch",
        "extras",
        "acceptance",
        "hazard-classes",
        "migrations",
        "conflicts-with",
        "parallelizable",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+-P[0-9]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^claude/m[0-9]+-p[0-9]+-.+$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "grounding": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "verified-root-cause": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "verification-first"
              }
            }
          }
        },
        "files-to-touch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extras": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "One criterion and exactly one of: the check that proves it, or the reason it cannot be a test (DR-0064).",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "$ref": "#/$defs/criterionCheck"
              },
              "not-testable": {
                "description": "Why no test or command can prove this criterion; the hazard reviewer answers it instead.",
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "oneOf": [
              { "required": ["check"], "properties": { "check": { "type": "object" } } },
              { "required": ["not-testable"], "properties": { "not-testable": { "type": "string" } } }
            ]
          }
        },
        "hazard-classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "addressed-by"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "addressed-by": {
                "type": "string",
                "pattern": "^(criterion .+|judgment-property-of-prose: .+|state-not-entered: .+|later-phase: M[0-9]+-P[0-9]+)$"
              }
            }
          }
        },
        "migrations": {
          "type": "string",
          "minLength": 1
        },
        "conflicts-with": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parallelizable": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fill-in": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filled", "root-cause", "fix-shape", "files"],
          "properties": {
            "filled": {
              "type": "boolean"
            },
            "root-cause": {
              "type": "string"
            },
            "fix-shape": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
