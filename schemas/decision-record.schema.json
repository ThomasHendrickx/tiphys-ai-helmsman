{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/decision-record.schema.json",
  "title": "Tiphys decision record",
  "description": "An owner decision record (blueprint section 7) with the fields R-063 and R-090 check; an open question is a record with status open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "project",
    "task",
    "question",
    "options",
    "reversibility",
    "vetoable",
    "revert-cost",
    "status",
    "decided",
    "date"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "decision-record"
    },
    "id": {
      "type": "string",
      "pattern": "^DR-[0-9]{4}$"
    },
    "project": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "consequence"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "consequence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reversibility": {
      "type": "string",
      "enum": ["reversible", "costly", "irreversible"]
    },
    "vetoable": {
      "type": "boolean"
    },
    "revert-cost": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "deferred", "decided"]
    },
    "decided": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "if": {
    "type": "object",
    "required": ["status"],
    "properties": { "status": { "const": "decided" } }
  },
  "then": {
    "type": "object",
    "required": ["decided"],
    "properties": { "decided": { "type": "string", "minLength": 1 } }
  }
}
