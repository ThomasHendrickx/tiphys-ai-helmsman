{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/executor-record.schema.json",
  "title": "Tiphys executor launch record",
  "description": "tasks/<id>/executor.json, written by an ExecutorAdapter at launch before the payload starts, so a failed write is a launch failure (DR-0006).",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter", "launchedAt"],
  "properties": {
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "launchedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "requestedTier": {
      "type": "string",
      "minLength": 1
    },
    "requestedRole": {
      "type": "string",
      "minLength": 1
    }
  }
}
