{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/verdict.schema.json",
  "title": "Tiphys clean-room review verdict",
  "description": "A clean-room review verdict: the decision, the findings behind it, and the three completeness arrays that say what the review actually walked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "phase",
    "head",
    "verdict",
    "produced-by",
    "framing",
    "findings",
    "deviations-judged"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "verdict"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tiphys-version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "FIX-ROUND-NEEDED"]
    },
    "produced-by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "framing": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "review-contract": {
      "type": "string",
      "enum": ["criteria", "hazard"]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterionWalk"
      }
    },
    "deviations-judged": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviationJudgement"
      }
    },
    "hazard-classes-addressed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hazardClassAddressed"
      }
    }
  },
  "if": {
    "properties": {
      "findings": {
        "type": "array",
        "contains": {
          "type": "object",
          "required": ["severity"],
          "properties": {
            "severity": {
              "type": "string",
              "enum": ["high", "critical"]
            }
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "verdict": {
        "type": "string",
        "enum": ["FIX-ROUND-NEEDED"]
      }
    }
  },
  "oneOf": [
    {
      "description": "Branch A, the criteria contract (history since M6-P2): review-contract criteria with a non-empty criteria list.",
      "required": ["review-contract", "criteria"],
      "properties": {
        "review-contract": {
          "type": "string",
          "const": "criteria"
        },
        "criteria": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "description": "Branch B, the hazard contract: every verdict that does not say criteria, with at least one hazard class addressed.",
      "required": ["hazard-classes-addressed"],
      "properties": {
        "review-contract": {
          "type": "string",
          "const": "hazard"
        },
        "hazard-classes-addressed": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "evidence", "concrete-fix"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "concrete-fix": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "analysis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "criterionWalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quote", "evidence", "met"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "deviationJudgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation", "serves-plan-intent", "reasoning"],
      "properties": {
        "deviation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "serves-plan-intent": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "hazardClassAddressed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class-id", "probed"],
      "properties": {
        "class-id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "probed": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cleared-because": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "required": ["finding"],
          "properties": {
            "finding": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "required": ["cleared-because"],
          "properties": {
            "cleared-because": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
