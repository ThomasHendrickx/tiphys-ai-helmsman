{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/charter.schema.json",
  "title": "Tiphys project charter",
  "description": "Blueprint section 7: what a project realizes the kernel against; a missing required field blocks realization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identity",
    "delivery-mode",
    "assurance-tier",
    "yolo-permissions",
    "irreversible-decisions",
    "product-intent",
    "constraints",
    "escalation-contract",
    "release-verification",
    "retention"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "charter"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "kernel-version-pin"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "kernel-version-pin": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "delivery-mode": {
      "type": "string",
      "enum": ["full", "direct-pr", "local-only"]
    },
    "assurance-tier": {
      "type": "string",
      "enum": ["full", "direct-pr", "local-only"]
    },
    "yolo-permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "scope"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "irreversible-decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "language",
        "framework",
        "core-data-model",
        "tenancy",
        "auth",
        "deployment-topology"
      ],
      "properties": {
        "stack": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "core-data-model": { "type": "string", "minLength": 1 },
        "tenancy": { "type": "string", "minLength": 1 },
        "auth": { "type": "string", "minLength": 1 },
        "deployment-topology": { "type": "string", "minLength": 1 }
      }
    },
    "product-intent": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "escalation-contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop-for", "route"],
      "properties": {
        "stop-for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "route": { "type": "string", "minLength": 1 }
      }
    },
    "release-verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "reserved"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "if": {
        "type": "object",
        "required": ["mode"],
        "properties": { "mode": { "const": "none" } }
      },
      "then": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1 } }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "type": "string", "const": "none" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "note"],
          "properties": {
            "mode": { "type": "string", "const": "reserved" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "review-families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reason"],
      "properties": {
        "available": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review-executor": {
      "description": "The executor module review dispatch loads when no --executor is given; with neither, the dispatch is refused.",
      "type": "string",
      "minLength": 1
    },
    "runtime-set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!\\./)(?!.*//)(?!(?:.*/)?\\.{1,2}(?:/|$))(?!\\s)(?!.*\\s$)[^*?\\[\\\\]+$" }
        },
        "manifests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!\\./)(?!.*//)(?!.*/$)(?!(?:.*/)?\\.{1,2}(?:/|$))(?!\\s)(?!.*\\s$)[^*?\\[\\\\]+$" }
        },
        "version-pins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work-history", "evidence", "tuition"],
      "properties": {
        "work-history": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "tuition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
