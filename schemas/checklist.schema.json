{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/checklist.schema.json",
  "title": "Tiphys review checklist",
  "description": "A review checklist: a list of probes a reviewer answers, plus the framings that decide which probe they answer first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "applies-to", "probes"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "checklist"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "applies-to": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "framings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/framing"
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "probe", "applies-to", "evidence-required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "probe": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "applies-to": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "evidence-required": {
          "type": "boolean"
        },
        "verifies-gate": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry-point", "orders-probes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "entry-point": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "orders-probes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
