{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/mechanism-index.schema.json",
  "title": "Tiphys mechanism index",
  "description": "One document per project: each mechanism it has learned about, the rule that learning set, its sibling implementations and the artifacts that paid for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "mechanisms"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "mechanism-index"
    },
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "supersedes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "rule", "evidence"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "siblings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "machine-readable-form": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "key"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
