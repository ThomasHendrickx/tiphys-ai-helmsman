{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/status-line.schema.json",
  "title": "Tiphys status-line record",
  "description": "R-084: the owner hears of milestones only; there is no info, progress or heartbeat state, so routine noise cannot be written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "at", "run", "project", "state", "detail", "refs"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "status-line"
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": ["needs-decision", "blocked", "done", "failed", "phase-change"]
    },
    "detail": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
