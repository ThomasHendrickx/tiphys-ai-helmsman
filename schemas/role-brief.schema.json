{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/role-brief.schema.json",
  "title": "Tiphys role-brief frontmatter",
  "description": "The YAML frontmatter of every roles/*.md file and of AGENTS.md: role, lifetime, visibility, reading order, verifiers, outputs, model tier and clause ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "lifetime",
    "sees",
    "never",
    "mandated-reading",
    "verifiers",
    "outputs",
    "model-tier",
    "clauses"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "orchestrator",
        "investigator",
        "plan-writer",
        "adversarial-plan-reviewer",
        "implementer",
        "clean-room-reviewer"
      ]
    },
    "lifetime": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "never": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "mandated-reading": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "model-tier": {
      "type": "string",
      "enum": ["strongest", "cheaper"]
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
      }
    }
  }
}
