{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiphys.dev/schemas/model-resolution.schema.json",
  "title": "Tiphys model-resolution record",
  "description": "tasks/<id>/model-resolution.json, written by a harness adapter at turn end: the tier requested, the tier the charter resolved, and the family that served.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "writer",
    "writtenAt",
    "turnEnd",
    "subject",
    "resolution",
    "resolved"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "model-resolution"
    },
    "contractVersion": {
      "type": "string",
      "enum": ["1"]
    },
    "writer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "writtenAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
    },
    "turnEnd": {
      "$ref": "#/$defs/turnEnd"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "resolved": {
      "$ref": "#/$defs/resolved"
    }
  },
  "$defs": {
    "turnEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endedAt", "exitCode"],
      "properties": {
        "endedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
        },
        "exitCode": {
          "type": "integer"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "role", "requestedTier"],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requestedTier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "tier", "overrideApplied", "provenance", "observation"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "overrideApplied": {
          "type": "boolean"
        },
        "charterPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "charterTier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provenance": {
          "type": "string",
          "enum": ["observed"]
        },
        "observation": {
          "$ref": "#/$defs/overrideObservation"
        }
      },
      "oneOf": [
        {
          "required": ["overrideApplied", "charterPath", "charterTier"],
          "properties": {
            "overrideApplied": {
              "type": "boolean",
              "const": true
            },
            "charterPath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "charterTier": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "required": ["overrideApplied"],
          "properties": {
            "overrideApplied": {
              "type": "boolean",
              "const": false
            }
          }
        }
      ]
    },
    "overrideObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consulted", "detail"],
      "properties": {
        "consulted": {
          "type": "boolean"
        },
        "configPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "configPermission": {
          "type": "string",
          "enum": ["allowed", "forbidden"]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "required": ["consulted", "configPath", "configPermission"],
          "properties": {
            "consulted": {
              "type": "boolean",
              "const": true
            },
            "configPath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "configPermission": {
              "type": "string",
              "enum": ["allowed", "forbidden"]
            }
          }
        },
        {
          "required": ["consulted"],
          "properties": {
            "consulted": {
              "type": "boolean",
              "const": false
            }
          }
        }
      ]
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "taskId", "model", "detail"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary", "provenance"],
      "properties": {
        "vocabulary": {
          "$ref": "#/$defs/vocabulary"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provenance": {
          "type": "string",
          "enum": ["observed", "self-reported", "unresolved"]
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "required": ["provenance", "observation", "family", "model"],
          "properties": {
            "provenance": {
              "type": "string",
              "const": "observed"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "required": ["provenance", "family", "model"],
          "properties": {
            "provenance": {
              "type": "string",
              "const": "self-reported"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "required": ["provenance", "reason"],
          "properties": {
            "provenance": {
              "type": "string",
              "const": "unresolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
